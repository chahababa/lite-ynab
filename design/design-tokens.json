{
  "$schema": "Lite YNAB Material 3 Design Tokens",
  "version": "2.0.0",
  "style": "Material 3 (Material You) — Light & Bright",

  "colors": {
    "primary": "#1a73e8",
    "onPrimary": "#ffffff",
    "primaryContainer": "#e8f0fe",
    "onPrimaryContainer": "#001d35",

    "secondary": "#5b6470",
    "secondaryContainer": "#dfe2eb",
    "onSecondaryContainer": "#181c22",

    "tertiary": "#735471",
    "tertiaryContainer": "#fdd8f8",

    "background": "#fafbfd",
    "surface": "#ffffff",
    "surfaceDim": "#f3f4f7",
    "surfaceContainerLowest": "#ffffff",
    "surfaceContainerLow": "#f7f8fa",
    "surfaceContainer": "#f1f3f6",
    "surfaceContainerHigh": "#ebedf1",
    "surfaceContainerHighest": "#e5e7eb",

    "onSurface": "#1a1c1e",
    "onSurfaceVariant": "#44474b",
    "outline": "#e8eaed",
    "outlineVariant": "#c4c7cb",

    "money": {
      "income": "#1b873f",
      "incomeContainer": "#d6f5dd",
      "expense": "#d32f2f",
      "expenseContainer": "#fde7e7",
      "remain": "#1a73e8",
      "remainContainer": "#e8f0fe",
      "warn": "#b95000",
      "warnContainer": "#ffddc2"
    },

    "categoryPalette": {
      "food": "#e8590c",
      "transport": "#1a73e8",
      "shop": "#7c4dff",
      "home": "#1b873f",
      "health": "#d81b60",
      "fun": "#00838f"
    }
  },

  "darkMode": {
    "background": "#121316",
    "surface": "#1a1c1e",
    "surfaceContainer": "#1f2123",
    "onSurface": "#e3e3e6",
    "outline": "#2a2c2f"
  },

  "spacing": {
    "unit": "4px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "32px"
  },

  "borderRadius": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "28px",
    "full": "9999px"
  },

  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(16,24,40,0.04), 0 1px 3px rgba(16,24,40,0.06)",
    "2": "0 1px 2px rgba(16,24,40,0.06), 0 4px 8px rgba(16,24,40,0.08)",
    "3": "0 4px 8px rgba(16,24,40,0.08), 0 12px 24px rgba(16,24,40,0.10)"
  },

  "typography": {
    "fontFamily": {
      "sans": "'Roboto', 'Noto Sans TC', 'Source Han Sans TC', system-ui, sans-serif",
      "mono": "'Roboto Mono', 'JetBrains Mono', Menlo, monospace"
    },
    "scale": {
      "labelSmall": { "size": "11px", "weight": 500, "letterSpacing": "0.04em" },
      "labelMedium": { "size": "12px", "weight": 500, "letterSpacing": "0.04em" },
      "bodySmall": { "size": "12px", "weight": 400 },
      "bodyMedium": { "size": "14px", "weight": 400 },
      "bodyLarge": { "size": "16px", "weight": 400 },
      "titleSmall": { "size": "14px", "weight": 500 },
      "titleMedium": { "size": "16px", "weight": 500 },
      "titleLarge": { "size": "22px", "weight": 500 },
      "headlineSmall": { "size": "24px", "weight": 500 },
      "headlineMedium": { "size": "28px", "weight": 500 },
      "displaySmall": { "size": "36px", "weight": 500 },
      "displayMedium": { "size": "45px", "weight": 500 }
    },
    "numberScale": {
      "hero": "56px",
      "display": "36px",
      "title": "24px",
      "body": "16px",
      "caption": "11px"
    },
    "numberRules": {
      "fontFeatureSettings": "'tnum'",
      "fontVariantNumeric": "tabular-nums",
      "letterSpacing": "-0.01em",
      "alwaysUseMono": true,
      "alwaysUseThousandSeparator": true,
      "colorRules": {
        "income": "var(--money-income)",
        "expense": "var(--money-expense)",
        "remain": "var(--money-remain)",
        "over": "var(--money-warn)"
      }
    }
  },

  "motion": {
    "duration": {
      "short": "150ms",
      "medium": "250ms",
      "long": "400ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)"
    }
  }
}
