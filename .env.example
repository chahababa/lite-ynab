# 公開環境變數（建置期寫進前端）
# 本機開發請填 staging 專案 lite-ynab-staging 的值，避免動到正式記帳資料；正式值只放在 Railway。
# ANON_KEY 請填 Supabase Dashboard → Settings → API Keys 的 publishable key（sb_publishable_ 開頭）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hermes 文字記帳 webhook（server-side only；不可用 NEXT_PUBLIC_）
HERMES_WEBHOOK_SECRET=<server-only-secret>
# 選用；若只服務單一使用者，可固定 Hermes 寫入的 Lite YNAB user id
LITEYNAB_USER_ID=

# CTBC 信用卡通知收件匣（選用）。值只放 Railway，不要放進 repo。
# web 服務：開啟「待確認的刷卡」頁面
CTBC_INBOX_ENABLED=
# worker 服務（railway.worker.json）：每天讀 Gmail 的中信刷卡通知
CTBC_COLLECTOR_ENABLED=
CTBC_WORKER_CONFIG=
CTBC_GMAIL_CLIENT_ID=
CTBC_GMAIL_CLIENT_SECRET=<server-only-secret>
CTBC_GMAIL_REFRESH_TOKEN=<server-only-secret>
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>
